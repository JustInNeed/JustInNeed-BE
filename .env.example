# .env.example — 복사해서 .env 로 만들고 각자 값을 채운다. (.env 는 gitignore 대상)
#   cp .env.example .env
# bootRun 이 이 파일을 읽어 환경변수로 주입한다 (build.gradle 참고). jar 직접 실행 시엔 OS 환경변수로 넣어야 한다.

# ───────────── pgAdmin (웹 로그인 계정) ─────────────
PGADMIN_EMAIL=admin@justinneed.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051

# ───────────── PostgreSQL (도커 컨테이너) ─────────────
POSTGRES_DB=justinneed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 맥(호스트)에서 접근할 포트. 네이티브 PostgreSQL(5432)과 충돌 피하려고 5433 사용
POSTGRES_HOST_PORT=5433

# ───────────── 앱 DB 접속 (기본값은 위 도커 설정과 동일) ─────────────
# DB_URL=jdbc:postgresql://localhost:5433/justinneed
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# ───────────── OAuth2 클라이언트 정보 (카카오, 네이버 개발자 콘솔) ─────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ───────────── JWT / 리다이렉트 / CORS ─────────────
# 운영에서는 반드시 길고 무작위한 값으로 교체 (최소 48자 이상 권장)
JWT_SECRET=
# FE 주소가 localhost:3000 이 아니면 아래 세 개를 함께 바꾼다
# OAUTH_SUCCESS_REDIRECT_URI=http://localhost:3000/oauth/callback
# OAUTH_FAILURE_REDIRECT_URI=http://localhost:3000/login?error=oauth
# CORS_ALLOWED_ORIGINS=http://localhost:3000
