# 이 파일을 복사해 .env 로 만들고 값을 채우세요: cp .env.example .env
# ───────────── pgAdmin (웹 로그인 계정) ─────────────
PGADMIN_EMAIL=admin@justinneed.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051

# ───────────── PostgreSQL (도커 컨테이너) ─────────────
POSTGRES_DB=justinneed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 맥(호스트)에서 접근할 포트. 로컬에 다른 PostgreSQL이 5432를 쓰면 충돌 피하려고 5433 사용
POSTGRES_HOST_PORT=5433
